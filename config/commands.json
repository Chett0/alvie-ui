[
    {
        "name": "Learn",
        "description": "Learn a Mealy machine model",
        "executable": "bin/learn.exe",
        "args": [
            "--att-spec",
            "--encl-spec",
            "--oracle",
            "--tmpdir",
            "--res",
            "--sancus",
            "--secret",
            "--step-limit",
            "--debug",
            "--info",
            "--commit",
            "--epsilon",
            "--delta"
        ]
    },
    {
        "name": "Flow-analysis",
        "description": "Find flow-analysis (NI) violations between two models",
        "executable": "bin/fa.exe",
        "args": [
            "--m1-int",
            "--m2-int",
            "--m1-nint",
            "--m2-nint",
            "--witness-file-basename",
            "--tmpdir",
            "--cex-limit",
            "--debug"
        ]
    },
    {
        "name": "Execute",
        "description": "Runs the given raw input on the specified version of Sancus with the given SUL configuration",
        "executable": "bin/exec.exe",
        "args": [
            "--att-spec",
            "--encl-spec",
            "--tmpdir",
            "--sancus",
            "--sexp-input",
            "--commit",
            "--secret",
            "--ignore-interrupts",
            "--sancus-master-key",
            "--debug",
            "--info"
        ]
    },
    {
        "name": "Property-based testing",
        "description": "Random NI tests on the Sancus simulator without learning a model. Faster than Learn",
        "executable": "bin/pbt.exe",
        "args": [
            "--att-spec1",
            "--att-spec2",
            "--encl-spec",
            "--step-limit",
            "--tmpdir",
            "--sancus",
            "--commit",
            "--ignore-interrupts",
            "--sancus-master-key",
            "--debug",
            "--info"
        ]
    }
]