{
    "--att-spec": {
        "type": "filename",
        "description": "Path to attacker specification (.atdl file)",
        "extension": ".atdl",
        "validation": { "must_exists": true },
        "default": "/home/alvie/spec-lib/example/attacker.atdl",
        "required": true
    },
    "--encl-spec": {
        "type": "filename",
        "description": "Path to enclave specification (.etdl file)",
        "extension": ".etdl",
        "validation": { "must_exists": true },
        "default": "/home/alvie/spec-lib/example/enclave.etdl",
        "required": true
    },
    "--oracle": {
        "type": "choice",
        "description": "Oracle used for equivalence check",
        "values": ["randomwalk", "pac", "exhaustive"],
        "required": true
    },
    "--tmpdir": {
        "type": "directory",
        "description": "Temporary directory for intermediate results",
        "validation": { "must_exists": false },
        "default": "/tmp/alvie",
        "required": true,
        "prefilled": true
    },
    "--res": {
        "type": "filename",
        "description": "Path to save the learned model (.dot file)",
        "extension": ".dot",
        "validation": { "must_exists": false },
        "default": "/tmp/alvie/result.dot",
        "required": true
    },
    "--sancus": {
        "type": "directory",
        "description": "Path to the cloned sancus-core-gap repository",
        "validation": { "must_exists": true },
        "default": "/home/alvie/sancus-core-gap",
        "required": true,
        "prefilled": true
    },
    "--secret": {
        "type": "int",
        "description": "Secret value (required if enclave uses '?' secret vars)",
        "default": "0",
        "required": false
    },
    "--step-limit": {
        "type": "int",
        "description": "Max steps per random walk / PAC sample",
        "default": "200",
        "required": false
    },
    "--debug": {
        "type": "boolean",
        "description": "Enable debug-level logging",
        "required": false
    },
    "--info": {
        "type": "boolean",
        "description": "Enable info-level logging",
        "required": false
    },
    "--epsilon": {
        "type": "float",
        "description": "PAC epsilon parameter",
        "default": "0.001",
        "required": false
    },
    "--delta": {
        "type": "float",
        "description": "PAC delta parameter",
        "default": "0.001",
        "required": false
    },
    "--m1-int": {
        "type": "filename",
        "extension": ".dot",
        "description": "First Mealy machine model (.dot, interrupt variant)",
        "default": "/tmp/alvie/m1_int.dot",
        "validation": { "must_exists": true },
        "required": true
    },
    "--m2-int": {
        "type": "filename",
        "extension": ".dot",
        "description": "Second Mealy machine model (.dot, interrupt variant)",
        "default": "/tmp/alvie/m2_int.dot",
        "validation": { "must_exists": true },
        "required": true
    },
    "--m1-nint": {
        "type": "filename",
        "extension": ".dot",
        "description": "First Mealy machine model (.dot, non-interrupt variant)",
        "default": "/tmp/alvie/m1_nint.dot",
        "validation": { "must_exists": true },
        "required": true
    },
    "--m2-nint": {
        "type": "filename",
        "extension": ".dot",
        "description": "Second Mealy machine model (.dot, non-interrupt variant)",
        "default": "/tmp/alvie/m2_nint.dot",
        "validation": { "must_exists": true },
        "required": true
    },
    "--witness-file-basename": {
        "type": "directory",
        "description": "Output path prefix",
        "validation": { "must_exists": false },
        "default": "/tmp/alvie/witness",
        "required": true
    },
    "--cex-limit": {
        "type": "int",
        "description": "Number of counterexamples to enumerate",
        "default": "1",
        "required": false
    },
    "--sexp-input": {
        "type": "filename",
        "description": "Symbolic expression for simulator raw input",
        "required": true
    },
    "--commit": {
        "type": "hash",
        "description": "Simulator git commit to use",
        "required": false
    },
    "--ignore-interrupts": {
        "type": "boolean",
        "description": "Ignore interrupts",
        "required": false
    },
    "--sancus-master-key": {
        "type": "hex",
        "description": "Master key",
        "default": "cafe",
        "required": false
    },
    "--att-spec1": {
        "type": "filename",
        "description": "First attacker spec for 1st run (.atdl)",
        "extension": ".atdl",
        "validation": { "must_exists": true },
        "default": "/home/alvie/spec-lib/example/attacker.atdl",
        "required": true
    },
    "--att-spec2": {
        "type": "filename",
        "description": "Second attacker spec for 2nd run (.atdl)",
        "extension": ".atdl",
        "validation": { "must_exists": true },
        "default": "/home/alvie/spec-lib/example/attacker.atdl",
        "required": true
    }
}
